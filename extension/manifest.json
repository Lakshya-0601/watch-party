{
  "manifest_version": 3,
  "name": "ReelRoom — Watch Party Sync",
  "short_name": "ReelRoom",
  "version": "0.4.0",
  "description": "Watch Netflix, JioHotstar, Prime Video, Apple TV+ and Crunchyroll in sync with friends: shared play/pause/seek, live chat and reactions.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ReelRoom",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "shared/config.js",
      "shared/protocol.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.hotstar.com/*",
    "*://*.primevideo.com/*",
    "https://tv.apple.com/*",
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.hotstar.com/*",
        "*://*.primevideo.com/*",
        "https://tv.apple.com/*",
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "content/keyguard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.hotstar.com/*",
        "*://*.primevideo.com/*",
        "https://tv.apple.com/*",
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "shared/config.js",
        "shared/protocol.js",
        "content/video-finder.js",
        "content/site-adapters.js",
        "content/sync-engine.js",
        "content/overlay-styles.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "page/netflix-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "shared/config.js",
        "app/app-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://static.crunchyroll.com/vilos-v2/*"
      ],
      "js": [
        "content/keyguard.js",
        "shared/config.js",
        "shared/protocol.js",
        "content/video-finder.js",
        "content/site-adapters.js",
        "content/sync-engine.js",
        "content/overlay-styles.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sync@reelroom.app",
      "strict_min_version": "128.0"
    }
  }
}
