rules_version = '2';

// ReelRoom only reads and writes Firestore from its server (Firebase Admin SDK,
// which bypasses these rules). Browsers never talk to Firestore directly, so
// deny everything to clients. Paste this into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
